        "        DisBlock(512,256),\n",
        "        nn.Linear(256,1),\n",
        "        nn.Sigmoid()\n",
        "    )\n",
        "\n",
        "    def forward(self,input):\n",
        "      return self.main(input).view(-1,28,28)"
