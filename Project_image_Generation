        "class GenBlock(nn.Module):\n",
        "  def __init__(self,in_features,out_features):\n",
        "    super(GenBlock,self).__init__()\n",
        "    self.main = nn.Sequential(\n",
        "        nn.Linear(in_features,out_features),\n",
        "        nn.ReLU(True)\n",
        "    )\n",
        "\n",
        "    def forward(self,x):\n",
        "      return self.main(x)"
